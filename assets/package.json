{
  "name": "sopds-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SOPDS frontend assets",
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "sass --style=compressed --no-source-map scss/sopds.scss:../web_frontend/static/css/sopds.css",
    "build:js": "node scripts/build-js.mjs",
    "dev": "npm run watch:css",
    "watch:css": "sass --style=compressed --no-source-map --watch scss/sopds.scss:../web_frontend/static/css/sopds.css",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": ">=5.10.1 <6.0.0"
  },
  "devDependencies": {
    "esbuild": ">=0.28.1 <0.29.0",
    "jsdom": ">=29.1.1 <30.0.0",
    "sass": ">=1.101.7 <2.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
